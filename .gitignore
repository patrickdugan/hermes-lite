# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
hermes_lite.egg-info/
.pytest_cache/

# Environment / secrets
.env
.env.*
!.env.example

# Rust build artifacts
target/
*.so
*.dylib
*.pyd

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Demo output (large media files)
output/

# Logs and temp
logs/
tmp/
testlogs/
wandb/

# Private keys
*.ppk
*.pem

# Project memory (generated at runtime)
.hermes/

# Local agent/session state. These directories may contain credentials.
/.airis-pilot/
/codex-chat-sessions/

# Experiment runs remain local unless explicitly distilled into a report.
/experiments/*
!/experiments/README.md

# Machine-local eval configs. Commit portable fixtures as *.example.json.
/evals/*.local.json
/evals/storyworld_bonsai_20_lean.json
/evals/storyworld_bonsai_terminal_repair.json

# Node (for demo projects)
node_modules/
